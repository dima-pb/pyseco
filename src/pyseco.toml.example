# pyseco settings. Copy to pyseco.toml (not tracked by git, it contains passwords).
# Relative paths are relative to the directory of this file.

[server]
# XML-RPC connection to the dedicated server (dedicated_cfg.txt: xmlrpc_port, SuperAdmin password)
host = "127.0.0.1"
port = 5000
login = "SuperAdmin"
password = "SuperAdmin"

[controller]
# TM logins with all rights; other roles are given in game with /setrole
masteradmins = []
# plugins to load: ad, custom_votes, dedimania, discord, flexitime, jukebox, local_records, tmx, welcome
plugins = []
# database, logs and caches
data_dir = "data"
# all, verbose, debug, info, warning, error, fatal
log_level = "info"

[storage]
# sqlite: <data_dir>/pyseco.db; memory: nothing is kept when pyseco stops
backend = "sqlite"

[discord]
# bot token from https://discord.com/developers/applications -> your app -> Bot.
# There, also enable "Message Content Intent", otherwise the bot can't read the channel.
token = ""
# channel mirrored with the server chat (developer mode: right click the channel -> Copy Channel ID)
channel_id = 0
# shown in game next to the names of discord users (optional)
invite = ""
# prefix of bot commands in the channel
prefix = "!"

[jukebox]
# players can't wish one of the last <recent> maps (operators and above can)
recent = 10
# entries per player at a time (operators and above: no limit)
per_player = 1

[custom_votes]
# vote duration in ms and share of yes votes needed
timeout = 30000
ratio = 0.5

[welcome]
# "" switches a message off. Placeholders: {nickname} {login} {role} {visits} {visits_text} {server}
message = "Welcome {nickname}$z$s to {server}$z$s! Type $fff/pyseco$z$s for the commands."
join = "{nickname}$z$s joined the server ({visits_text})."
leave = "{nickname}$z$s left the server."

[flexitime]
# time per map in minutes (time attack); the server's own time limit is switched off
minutes = 60

[local_records]
# records per map
max = 50
# new records up to this rank are told to everybody (0: never)
announce = 30
# a player who improves without being announced is told privately
tell_player = true
# best records in the widget; below them the one to beat, the own and the last record
top = 5

[dedimania]
# the server's Dedimania community code (dedimania.net, or the server password)
code = ""
# the server's nation, 3 letters (IOC code)
nation = "OTH"
# new Dedimania records up to this rank are told to everybody, others only to the player
announce = 30
# best records in the widget; below them the one to beat, the own and the last record
top = 5
# false: only show the records, never send times (e.g. for a test server)
send = true

[tmx]
# TMX search filter for /rtmx (as in tmnf.exchange's track search, e.g. "primarytype=0&tag=6" for LOL maps);
# maps without TMUnlimiter and without environment mix are always required
random = "primarytype=0"
# TMX times in the widget (0: no widget)
top = 5

# Widgets can be moved: [widgets.<name>] with x (-64 left .. 64 right) and y (48 top .. -48 bottom) of the top left
# corner. Names: flexitime (the clock, default x = 49, y = 32), local_records (default x = 48, y = 26.5),
# dedimania (default x = 48, y = 3.7, below local_records), tmx (default x = 48, y = -18.7, below dedimania)
#[widgets.flexitime]
#x = 49
#y = 32
